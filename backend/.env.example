# Port d'écoute du serveur backend
PORT=5000

# Clé secrète pour signer les JSON Web Tokens (JWT).
# À CHANGER pour une chaîne de caractères longue et aléatoire.
JWT_SECRET=change_this_to_a_long_random_secret_key

# Ces variables sont utilisées pour un lancement local (hors Docker).
# Pour Docker, les valeurs sont définies dans docker-compose.yml.
DB_HOST=localhost
DB_USER=your_user
DB_PASSWORD=your_password
DB_NAME=your_database
